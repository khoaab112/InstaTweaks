{
  "manifest_version": 3,
  "name": "InstaTweaks 3.1 - Ultimate Instagram Suite",
  "version": "3.1.0",
  "description": "InstaTweaks v3.1: Watchlist & Bộ cào Follower an toàn, Xem Story & Đọc DM ẩn danh, Chặn quảng cáo, Làm nét Video HD.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "InstaTweaks v3.0",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "notifications"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["scripts/injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": [
        "scripts/v3_core.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/v3_sidebar.css",
        "styles/player.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "styles/*"
      ],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
