{
  "manifest_version": 3,
  "name": "IG Web Music Player - Nghe nhạc Instagram PC",
  "version": "1.9.8",
  "description": "Tự động phát nhạc bài viết, hỗ trợ tải toàn bộ ảnh/video bài viết và tải Story Instagram trên PC.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cài đặt IG Web Music Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["scripts/injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["scripts/content.js"],
      "css": ["styles/player.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "styles/*"
      ],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
